# ==============================================================================
# Cloudflare Pages SPA Routing Rules (_redirects)
# Ensures clean tool URLs (/tool/*) and virtual views serve index.html with HTTP 200
# ==============================================================================

# Guides routing for Cloudflare Pages / Netlify
/guides/es/:slug/index.html   /guides/es/:slug       301
/guides/pt/:slug/index.html   /guides/pt/:slug       301
/guides/:slug/index.html      /guides/:slug          301
/guides/es       /guides/es/index.html  200
/guides/es/      /guides/es/index.html  200
/guides/pt       /guides/pt/index.html  200
/guides/pt/      /guides/pt/index.html  200
/guides          /guides/index.html     200
/guides/         /guides/index.html     200
/guides/es/:slug /guides/es/:slug.html  200
/guides/pt/:slug /guides/pt/:slug.html  200
/guides/:slug    /guides/:slug.html     200

/tool/*        /index.html    200
/category/*    /index.html    200
/landing       /landing.html  200
/welcome       /landing.html  200
/showcase      /landing.html  200
/plans         /index.html    200
/payment-success /index.html  200
/payment-guide /index.html    200
/favorites     /index.html    200
/dashboard     /index.html    200
/privacy       /index.html    200
/privacy-policy /index.html   200
/about         /index.html    200
/about-us       /index.html    200
/contact       /index.html    200
/contact-us     /index.html    200
/terms         /index.html    200
/terms-of-service /index.html 200
/refund        /index.html    200
/refund-policy /index.html    200
/cookies       /index.html    200
/cookie-policy /index.html    200

# Proxy serverless API endpoints to Vercel backend
/api/*         https://omnitool-hub.vercel.app/api/:splat  200
