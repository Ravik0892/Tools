# ==============================================================================
# Cloudflare Pages SPA Routing Rules (_redirects)
# Ensures clean tool URLs (/tool/*) and virtual views serve index.html with HTTP 200
# ==============================================================================

/tool/*        /index.html    200
/category/*    /index.html    200
/plans         /index.html    200
/payment-success /index.html  200
/payment-guide /index.html    200
/favorites     /index.html    200
/dashboard     /index.html    200
/privacy       /index.html    200
/about         /index.html    200
/contact       /index.html    200
/terms         /index.html    200

# Proxy serverless API endpoints to Vercel backend
/api/*         https://omnitool-hub.vercel.app/api/:splat  200

