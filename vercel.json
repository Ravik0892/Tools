{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "destination": "https://omnitool.worldsneed.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), clipboard-read=(self), clipboard-write=(self)"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/social_media_assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/tools/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(style.css|app.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/guides/:lang(es|pt|de|fr)/:slug/index.html",
      "destination": "/guides/:lang/:slug.html"
    },
    {
      "source": "/guides/:slug/index.html",
      "destination": "/guides/:slug.html"
    },
    {
      "source": "/guides/:lang(es|pt|de|fr)/",
      "destination": "/guides/:lang/index.html"
    },
    {
      "source": "/guides/:lang(es|pt|de|fr)",
      "destination": "/guides/:lang/index.html"
    },
    {
      "source": "/guides/:lang(es|pt|de|fr)/:slug",
      "destination": "/guides/:lang/:slug.html"
    },
    {
      "source": "/guides/",
      "destination": "/guides/index.html"
    },
    {
      "source": "/guides",
      "destination": "/guides/index.html"
    },
    {
      "source": "/guides/:slug",
      "destination": "/guides/:slug.html"
    },
    {
      "source": "/tool/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/category/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/(plans|payment-guide|favorites|dashboard|privacy|privacy-policy|about|about-us|contact|contact-us|terms|terms-of-service|refund|refund-policy|cookies|cookie-policy)",
      "destination": "/index.html"
    }
  ]
}
