# ==============================================================================
# OmniTool Hub - Production Apache & LiteSpeed Configuration (Hostinger / cPanel)
# ==============================================================================

# 1. Enable Rewrite Engine for Single Page Application (SPA) Routing
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS (recommended for Hostinger SSL certificates)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} !^localhost
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Allow existing physical files and directories to be served directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Don't rewrite guides folder if static guide exists
  RewriteCond %{REQUEST_URI} ^/guides/ [NC]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # SPA Fallback: Direct all /tool/* and virtual routes to index.html
  RewriteRule ^(.*)$ index.html [L,QSA]
</IfModule>

# 2. Security Headers
<IfModule mod_headers.c>
  # Prevent MIME type sniffing
  Header set X-Content-Type-Options "nosniff"
  # Prevent clickjacking in unauthorized iframes
  Header set X-Frame-Options "SAMEORIGIN"
  # Enable browser XSS protection
  Header set X-XSS-Protection "1; mode=block"
  # Strict Referrer policy for privacy
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # Security permissions
  Header set Permissions-Policy "camera=(self), clipboard-read=(self), clipboard-write=(self)"
</IfModule>

# 3. Browser Caching via mod_expires (Optimized for LiteSpeed & Apache)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 7 days"

  # HTML & Service Worker: Always fresh, no aggressive cache
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 0 seconds"

  # Static Assets (Images, Icons, Fonts)
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"

  # CSS and Scripts
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# 4. Gzip & Deflate Compression for Lightning-Fast Loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# 5. Correct MIME Types
<IfModule mod_mime.c>
  AddType text/javascript .js
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest .json
  AddType application/wasm .wasm
</IfModule>

# 6. Disable Directory Browsing (Prevents users from listing files)
Options -Indexes
